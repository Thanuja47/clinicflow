# ClinicFlow Environment Variables

# Database Connection (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# Auth Secrets
JWT_SECRET="super-secret-clinicflow-access-token-key-change-in-prod"
JWT_REFRESH_SECRET="super-secret-clinicflow-refresh-token-key-change-in-prod"

# Supabase Storage
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SMSGo.lk API Integration
SMSGO_API_KEY="smsgo_live_key_here"
SMSGO_SENDER_ID="ClinicFlow"
